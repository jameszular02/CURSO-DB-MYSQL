{
  "name": "curso-php-mysql (Python + MariaDB + phpMyAdmin)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [3306, 8080],
  "portsAttributes": {
    "3306": {
      "label": "MariaDB",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "phpMyAdmin",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install mysql-connector-python",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
